{
  "manifest_version": 3,
  "name": "Watch Later Cleaner",
  "version": "1.0.0",
  "description": "Select and bulk-remove videos from your YouTube Watch Later playlist.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/playlist*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
